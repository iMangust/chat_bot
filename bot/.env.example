BOT_TOKEN=
TRACKED_CHAT_IDS=[]
ADMIN_IDS=[]

DATABASE_URL=mysql+aiomysql://tamabot:tamabot@127.0.0.1:3306/tamabot?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT=5

POLLING_TIMEOUT=10
POLLING_LIMIT=50

IS_DEV=true
LOG_LEVEL=INFO
WEBHOOK_URL=
WEBHOOK_PORT=8081
WEBHOOK_SECRET_TOKEN=change-me-in-env

MIN_MESSAGE_LENGTH=5
ACTIVITY_COOLDOWN_SEC=10
REACTIONS_CAP_PER_DAY=20
XP_PER_MESSAGE=2
XP_LEVEL_BASE=50.0
COINS_PER_MESSAGE_CAP=1
INVITE_REWARD_COINS=50
SHOW_INVITE_BUTTON=true

# Часовой пояс пользователей относительно UTC (Камчатка = 12, Asia/Kamchatka)
TZ_OFFSET_HOURS=0
# Часовой пояс пользователей относительно UTC (0 = UTC, 12 = историческая
# Камчатка). Вся временная логика (хранилище, планировщик, дни стриков)
# следует за этой настройкой.
# ВРЕМЯ В БАЗЕ: колонки created_at/last_seen хранятся в ЛОКАЛЬНОМ времени
# (TZ_OFFSET_HOURS) — «в базе то же, что на часах». Границы SQL-запросов
# (db_bound) подаются без сдвига. Планировщик и рассылки тоже локальные.
# Часы рассылок в ЛОКАЛЬНОМ времени (TZ_OFFSET_HOURS), а не в UTC.
# Старые ключи *_HOUR_UTC поддерживаются обратно совместимо и автоматически
# пересчитываются в локальные часы при отсутствии новых.
DAILY_REPORT_HOUR=21
MORNING_REMINDER_HOUR=9
EVENING_REMINDER_HOUR=20
PET_WARNING_MIN_HOURS=6
STREAK_WARN_THRESHOLD_SEC=21600

WEATHER_ENABLED=true
WEATHER_REAL_ENABLED=true
WEATHER_REFRESH_HOURS=3.0
WEATHER_CACHE_MINUTES=180
OPENWEATHER_API_KEY=
WEATHER_CITY=Петропавловск-Камчатский
WEATHER_LAT=53.0446
WEATHER_LON=158.6507

CHANNEL_USERNAME=botovstest
CHANNEL_USERNAME_VISUAL=
CHANNEL_CHAT_ID=
CHANNEL_SCAN_MINUTES=30

API_ID=
API_HASH=
PHONE=
TELEGRAM_PASSWORD=
SESSION_STRING=
SESSION_FILE=mtproto_sync
ANSWER_MODE=off
MTPROTO_AUTOSYNC=true
MTPROTO_SYNC_MINUTES=60
MTPROTO_FULL_SCAN_HOURS=6

MERCH_ENABLED=true
MERCH_URL=
MERCH_ITEMS=

# --- Веб-панель управления (app.web.server) ---
# IP, на котором слушает панель: 127.0.0.1 — только локально; 0.0.0.0 — удалённый доступ
# (в этом случае обязательно заполните DASHBOARD_ALLOWED_IPS). Нужен перезапуск панели.
DASHBOARD_HOST=127.0.0.1
# Порт панели (по умолчанию 8765). Нужен перезапуск панели.
DASHBOARD_PORT=8765
# Белый список IP для доступа к панели через запятую (можно подсети CIDR), напр. 203.0.113.5,198.51.100.0/24.
# Пусто = доступ только с localhost.
DASHBOARD_ALLOWED_IPS=
# Доверять X-Forwarded-For (включать только за nginx/доверенным прокси, иначе белый список обходится).
DASHBOARD_TRUST_PROXY=false
# Токен доступа к API панели. Если задан — используется В ПРИОРИТЕТЕ;
# иначе берутся WEBHOOK_SECRET_TOKEN (если не дефолтный) или BOT_TOKEN.
# Фронтенд получает его сам через /api/token, в браузере вводить не нужно.
DASHBOARD_TOKEN=
