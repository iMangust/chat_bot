BOT_TOKEN=  # Telegram bot token from @BotFather
TRACKED_CHAT_IDS=[]  # Chat IDs tracked for XP and reactions, JSON list e.g. [123456789]
ADMIN_IDS=[]  # Telegram user IDs with admin rights, JSON list e.g. [123456789]

DATABASE_URL=mysql+aiomysql://tamabot:tamabot@127.0.0.1:3306/tamabot?charset=utf8mb4  # MySQL DSN, e.g. mysql+aiomysql://user:pass@127.0.0.1:3306/tama?charset=utf8mb4
REDIS_URL=redis://127.0.0.1:6379/0  # Redis DSN used for cache and rate limits
REDIS_SOCKET_TIMEOUT=5  # Redis socket timeout in seconds

POLLING_TIMEOUT=10  # Long polling timeout in seconds
POLLING_LIMIT=50  # Long polling batch size (max 100)

IS_DEV=true  # Dev mode: verbose errors and local shortcuts
LOG_LEVEL=INFO  # Logging level: DEBUG INFO WARNING ERROR
WEBHOOK_URL=  # Public HTTPS URL to switch from polling to webhook; empty = polling
WEBHOOK_PORT=8081  # Port for the webhook server
WEBHOOK_SECRET_TOKEN=change-me-in-env  # Secret token verified in X-Telegram-Bot-Api-Secret-Token header

MIN_MESSAGE_LENGTH=5  # Minimum message length counted as activity
ACTIVITY_COOLDOWN_SEC=10  # Cooldown between counted messages per user, seconds
REACTIONS_CAP_PER_DAY=20  # Daily cap of auto-reactions per chat
XP_PER_MESSAGE=2  # XP granted per qualifying message
XP_LEVEL_BASE=50.0  # Base XP needed for level 2 (grows per level)
COINS_PER_MESSAGE_CAP=1  # Max coins per message
INVITE_REWARD_COINS=50  # Coins reward for a friend invite

TZ_OFFSET_HOURS=3  # User-facing timezone offset from UTC in hours
DAILY_REPORT_HOUR_UTC=17  # UTC hour for daily reports
MORNING_REMINDER_HOUR_UTC=7  # UTC hour for morning pet reminders
EVENING_REMINDER_HOUR_UTC=16  # UTC hour for evening pet reminders
PET_WARNING_MIN_HOURS=6  # Hours of neglect before warning
STREAK_WARN_THRESHOLD_SEC=21600  # Streak warning threshold in seconds

WEATHER_ENABLED=true  # Master switch for weather feature
WEATHER_REAL_ENABLED=true  # Use real OpenWeather API; false = simulated data
WEATHER_REFRESH_HOURS=3.0  # How often real weather is refreshed
WEATHER_CACHE_MINUTES=180  # Weather response cache TTL in minutes
# API key from openweathermap.org. Free plan One Call needs a paid subscription;
# without it the bot falls back to /2.5/weather + /2.5/forecast automatically.
OPENWEATHER_API_TOKEN=
OPENWEATHER_API_KEY=

CHANNEL_USERNAME=  # Private channel/group @username required to DM the bot
CHANNEL_CHAT_ID=  # Numeric ID of the subscription channel (alternative to username)
CHANNEL_SCAN_MINUTES=30  # Live member scan interval for the channel, minutes

API_ID=  # api_id from my.telegram.org (enables MTProto subscriber sync)
API_HASH=  # api_hash from my.telegram.org
PHONE=  # Phone of the bot/user account used for MTProto
TELEGRAM_PASSWORD=  # 2FA password if set on the MTProto account
SESSION_STRING=  # Pre-generated MTProto session string (preferred over login)
SESSION_FILE=mtproto_sync  # MTProto session file name (without .session) or full path
ANSWER_MODE=off  # MTProto answering: off | manual | auto
MTPROTO_AUTOSYNC=true  # Periodically sync channel subscribers via MTProto
MTPROTO_SYNC_MINUTES=60  # Incremental subscriber sync interval, minutes
MTPROTO_FULL_SCAN_HOURS=6  # Full channel re-scan interval, hours

MERCH_ENABLED=false  # Show merch section in /shop
MERCH_URL=  # External merch store link
MERCH_ITEMS=  # Merch items list, format: name|price|url;name|price|url

DASHBOARD_ALLOWED_IPS=  # Comma-separated IPs allowed to open web dashboard; empty = all
DASHBOARD_TRUST_PROXY=false  # Trust X-Forwarded-For when checking dashboard IP
