# ============ Telegram ============
# Токен от @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# ID канала и группы обсуждения через запятую (пусто = считать активность во всех чатах бота).
# Узнать ID: перешлите сообщение из группы @userinfobot или добавьте бота и посмотрите логи.
TRACKED_CHAT_IDS=[-1001234567890,-1009876543210]

# ============ База данных (MySQL на Windows Server) ============
# Создать БД и пользователя:
#   CREATE DATABASE tamabot CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'tamabot'@'localhost' IDENTIFIED BY 'strong-password';
#   GRANT ALL PRIVILEGES ON tamabot.* TO 'tamabot'@'localhost';
DATABASE_URL=mysql+aiomysql://tamabot:strong-password@127.0.0.1:3306/tamabot?charset=utf8mb4

# ============ Redis (опционально) ============
# На Windows ставится через Memurai (https://memurai.dev) или WSL2.
# Без Redis бот работает на in-memory fallback (кулдауны/FSM сбрасываются при рестарте).
REDIS_URL=redis://127.0.0.1:6379/0

# ============ Запуск ============
# Windows Server: только polling. webhook_url не используется.
IS_DEV=false
LOG_LEVEL=INFO
POLLING_TIMEOUT=10
POLLING_LIMIT=50

# ============ Вебхук (опционально, только если IS_DEV=false и задан URL) ============
# WEBHOOK_URL=https://your-domain.com
# WEBHOOK_PORT=8081
# ОБЯЗАТЕЛЬНО в проде: секрет, который Telegram шлёт в заголовке
# X-Telegram-Bot-Api-Secret-Token — защита от фейковых апдейтов на ваш URL.
# WEBHOOK_SECRET_TOKEN=change-me-in-env

# ============ Баланс / антифрод (значения по умолчанию можно не менять) ====
# MIN_MESSAGE_LENGTH=5
# ACTIVITY_COOLDOWN_SEC=10
# REACTIONS_CAP_PER_DAY=20
# XP_PER_MESSAGE=2
# COINS_PER_MESSAGE_CAP=1
# INVITE_REWARD_COINS=50
# TZ_OFFSET_HOURS=3

# ============ Админ ============
# Ваш Telegram ID (число), через запятую — доступ к /admin
ADMIN_IDS=[111111111]

# ============ Канал / рефералка ============
# Публичный юзернейм КАНАЛА (без @) — реферальная ссылка ведёт на канал
# CHANNEL_USERNAME=mychannel
# CHANNEL_CHAT_ID=-1001234567890

# ============ Мерч канала (раздел 🧢) ============
# MERCH_ENABLED=true
# MERCH_URL=https://your-merch-shop.example
# Витрина: "Категория|Название|Цена₽|Описание|Размеры(S,M,L)" (можно несколько строк)
# MERCH_ITEMS=tshirt|Футболка «Не флуди»|1490|Чёрная футболка канала|S,M,L,XL


# ============ Опционально: Telegram API (MTProto) — sync подписчиков ============
# Нужен ТОЛЬКО для `python -m app.services.mtproto_sync` — заносит ВСЕХ
# участников канала в welcome-очередь (Bot API не отдаёт список участников).
# Без этих ключей бот работает полностью. Ключи: https://my.telegram.org
# Используйте ВТОРОЙ (service) аккаунт, не личный! Секреты — только здесь.
# API_ID=12345678
# API_HASH=0123456789abcdef0123456789abcdef
# PHONE=+79001234567
# TELEGRAM_PASSWORD=          # 2FA облачный пароль, если включён
# MTPROTO_SESSION_STRING=     # строка сессии (см. README), либо пустое поле
# MTPROTO_SESSION=mtproto_sync  # путь к .session-файлу (альтернатива строке)

# --- Приветствие новичков канала ---
# WELCOME_CHANNEL_ENABLED=true        # слать приветствие в ЛС новым подписчикам канала
# CHANNEL_SCAN_MINUTES=30             # период фонового скана счётчика участников
# CHANNEL_WELCOME_TEXT=               # свой шаблон ({name}, {channel}); пусто = дефолтный
