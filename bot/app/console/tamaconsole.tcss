/* TamaConsole — стили */

StatusPanel {
    height: 1;
    padding: 0 1;
    background: $primary;
}

StatusPanel > Horizontal {
    width: 100%;
    height: 1;
}

#brand { width: auto; margin-right: 2; }
#state { width: auto; margin-right: 2; }
#uptime { width: auto; margin-right: 2; }
/* часы прижаты вправо пустым stretch-виджетом перед ними (в Textual нет right) */
#clock-spacer { width: 1fr; }
.clock { width: auto; color: $text-muted; }

ControlsBar {
    height: 3;
    padding: 1 1 0 1;
    layout: horizontal;
}

ControlsBar Button {
    margin-right: 2;
}

TabbedContent {
    height: 1fr;
}

LogsTab, DashboardTab, DatabaseTab, SettingsTab, SearchTab {
    padding: 0 1;
}

#log-filter-bar {
    height: 3;
    align-horizontal: left;
}

#log-filter-bar Button { margin-right: 1; }
#log-search { width: 1fr; margin-left: 1; }

#log-view {
    height: 1fr;
    border: round $primary;
}

#dash-state, #dash-jobs, #dash-db {
    height: auto;
    margin-bottom: 1;
    padding: 0 1;
    border: tall $surface;
}

#db-toolbar, #set-toolbar {
    height: 3;
    margin-bottom: 1;
}

#db-toolbar Button, #set-toolbar Button { margin-right: 1; }

#db-table, #set-table {
    height: 1fr;
    border: round $primary;
}

#db-status, #set-status {
    height: 1;
    color: $text-muted;
}

#u-result {
    height: 1fr;
    border: round $primary;
    padding: 0 1;
}

ConfirmQuit Vertical, EditSetting Vertical {
    align-horizontal: center;
}

ConfirmQuit Horizontal, EditSetting Horizontal {
    align-horizontal: right;
    width: 100%;
}

ConfirmQuit Horizontal Button, EditSetting Horizontal Button {
    margin-left: 2;
}
